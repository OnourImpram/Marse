{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARSAM Claim Provenance Record",
  "type": "object",
  "required": [
    "id",
    "sourceIds",
    "support",
    "reviewStatus"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^s-"
      }
    },
    "support": {
      "enum": [
        "source-bound-edition",
        "editorial-synthesis"
      ]
    },
    "reviewStatus": {
      "enum": [
        "AI_ASSISTED_DRAFT",
        "HUMAN_REVIEWED",
        "OUTDATED"
      ]
    },
    "sourceLocation": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "claimType": {
      "type": "string"
    },
    "scientificApproval": {
      "type": "boolean"
    },
    "localeReview": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "AI_ASSISTED_DRAFT",
          "HUMAN_REVIEWED",
          "OUTDATED"
        ]
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
